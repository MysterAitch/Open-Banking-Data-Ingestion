# Copy to .env and fill in. .env is gitignored.
#
# BY DESIGN THIS FILE HOLDS NO SECRETS - only paths, identifiers and URLs. Every
# credential lives in its own file, referenced by a *_FILE variable. That is what
# makes this file safe to read, paste or attach to a bug report, and it is worth
# preserving: the moment a secret is pasted inline that stops being true, and
# nothing announces it.
#
# Paths below are relative to the repository root. Anything holding data or
# credentials sits OUTSIDE it, so a stray `git add -A` cannot take them.

# --- Where data lives ---
OBDI_RAW_DIR=./data/raw
OBDI_DB_PATH=./data/store.sqlite3
# Bank refresh tokens. Deliberately NOT under the data path: that tree is meant
# to be copied, backed up and pointed at analysis tools, and credentials must not
# travel with every copy of it.
OBDI_CONNECTION_STORE=../obdi-secrets/connections.json
# Binds each provider's account id to a canonical account, so one account seen
# through several sources cross-checks instead of double-counting. Copy
# docs/accounts.example.json here; a pull names any account still unbound.
OBDI_ACCOUNT_MAP=./data/accounts.json

# --- TrueLayer (UK/EU aggregator) ---
# From console.truelayer.com. The client id is not a secret and stays inline; a
# LIVE id has no "sandbox-" prefix. Signing keys are a Payments concern and are
# NOT needed for the Data API.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET_FILE=../obdi-secrets/truelayer-client-secret
# Must match a redirect URI registered on the application BYTE FOR BYTE, trailing
# slash included, or authorisation is rejected. Console changes can take ~15
# minutes to propagate. TrueLayer hosts a redirect page that simply displays the
# returned code, which is the least friction for a manual flow; point this at
# your own /callback once the web interface is running somewhere reachable.
TRUELAYER_REDIRECT_URI=https://console.truelayer.com/redirect-page

# --- Starling (first-party; only if you bank with Starling) ---
# Personal access token from developer.starlingbank.com/personal/token
# Read-only scopes: account:read balance:read transaction:read space:read
# First-party access to your own bank is not an account information service, so
# there is no 90-day consent clock on this one.
STARLING_PERSONAL_ACCESS_TOKEN_FILE=../obdi-secrets/starling-token

# --- Monzo (first-party; only if you bank with Monzo) ---
# Register a CONFIDENTIAL client at developers.monzo.com - only those receive
# refresh tokens. Note the five-minute window: full history is available only
# briefly after authenticating, then a rolling 90 days.
#MONZO_CLIENT_ID=
#MONZO_CLIENT_SECRET_FILE=../obdi-secrets/monzo-client-secret

# --- Enable Banking (EEA only; does NOT serve the UK) ---
#EB_APPLICATION_ID=
#EB_PRIVATE_KEY_PATH=../obdi-secrets/enablebanking-private-key.pem
#EB_REDIRECT_URI=https://localhost:8080/callback

# --- Actual Budget (replay target; not needed for ingestion) ---
# Loopback if Actual runs on this machine; otherwise wherever you reach it.
ACTUAL_SERVER_URL=http://127.0.0.1:5006
# From Actual: Settings -> Advanced -> Sync ID.
ACTUAL_SYNC_ID=
ACTUAL_PASSWORD_FILE=../obdi-secrets/actual-server-password
# Only if the budget file is end-to-end encrypted:
#ACTUAL_ENCRYPTION_PASSWORD_FILE=../obdi-secrets/actual-encryption-password

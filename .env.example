# Copy to .env and fill in. .env is gitignored and must never be committed.
# Claude does not read .env - only this example file.

# --- Where data lives (absolute paths, OUTSIDE this repo) ---
OBDI_RAW_DIR=./data/obdi-raw
OBDI_DB_PATH=./data/obdi/store.sqlite3

# --- Enable Banking (aggregator; covers banks with no first-party API) ---
# Application ID from https://enablebanking.com/cp/applications
EB_APPLICATION_ID=
# Path to the private key .pem downloaded when the application was created.
EB_PRIVATE_KEY_PATH=../obdi-secrets/enablebanking/private_key.pem

# --- Starling (first-party; only if you bank with Starling) ---
# Personal access token from https://developer.starlingbank.com/personal/token
# Scopes needed for read-only: account:read balance:read transaction:read space:read
STARLING_PERSONAL_ACCESS_TOKEN=

# --- Monzo (first-party; only if you bank with Monzo) ---
# Register a CONFIDENTIAL client at https://developers.monzo.com/
# Confidential clients get refresh tokens; non-confidential do not.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# --- Actual Budget (replay target; not needed for ingestion) ---
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
# Only if the budget file is end-to-end encrypted:
ACTUAL_ENCRYPTION_PASSWORD=

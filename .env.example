# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# SECRETS BY INDIRECTION: every secret has a *_FILE variant holding a PATH to
# a file containing the value. Prefer it. Then .env carries only paths, and can
# be read, pasted or attached to a bug report without leaking anything. The
# _FILE form wins if both are set. Keep the target files outside every repo.

# --- Where data lives (absolute paths, OUTSIDE this repo) ---
OBDI_RAW_DIR=./data/obdi-raw
OBDI_DB_PATH=./data/obdi/store.sqlite3

# --- Enable Banking (aggregator; covers banks with no first-party API) ---
# Application ID from https://enablebanking.com/cp/applications
EB_APPLICATION_ID=
# Path to the private key .pem exported when the application was created.
# Shown ONCE at registration - keep a backed-up copy outside every git repo.
EB_PRIVATE_KEY_PATH=../obdi-secrets/enablebanking/private_key.pem
# Must match a redirect URL registered on the application BYTE FOR BYTE,
# trailing slash included, or bank authorisation is rejected.
EB_REDIRECT_URI=https://localhost:8080/callback

# --- TrueLayer (aggregator; live Data API access is being tested) ---
# From console.truelayer.com. The environment matters: a LIVE client id does
# NOT start with "sandbox-". Signing keys are a Payments concern and are not
# needed for the Data API.
# The client id is not a secret and stays inline.
TRUELAYER_CLIENT_ID=
# Preferred: a path to a file holding the secret.
TRUELAYER_CLIENT_SECRET_FILE=../obdi-secrets/truelayer/client-secret.txt
# Fallback, ignored when the _FILE form above is set:
#TRUELAYER_CLIENT_SECRET=
# Must match a redirect URI registered on the application byte for byte, and
# console changes take up to 15 minutes to propagate. TrueLayer's own hosted
# redirect page is the least friction for a manual flow: it renders the
# returned code instead of leaving a failed localhost connection to read.
TRUELAYER_REDIRECT_URI=https://console.truelayer.com/redirect-page

# --- Starling (first-party; only if you bank with Starling) ---
# Personal access token from https://developer.starlingbank.com/personal/token
# Scopes needed for read-only: account:read balance:read transaction:read space:read
STARLING_PERSONAL_ACCESS_TOKEN_FILE=../obdi-secrets/starling/personal-access-token.txt
#STARLING_PERSONAL_ACCESS_TOKEN=

# --- Monzo (first-party; only if you bank with Monzo) ---
# Register a CONFIDENTIAL client at https://developers.monzo.com/
# Confidential clients get refresh tokens; non-confidential do not.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET_FILE=../obdi-secrets/monzo/client-secret.txt
#MONZO_CLIENT_SECRET=

# --- Actual Budget (replay target; not needed for ingestion) ---
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_PASSWORD_FILE=../obdi-secrets/actual/server-password.txt
ACTUAL_SYNC_ID=
# Only if the budget file is end-to-end encrypted:
ACTUAL_ENCRYPTION_PASSWORD_FILE=../obdi-secrets/actual/encryption-password.txt
